{
  "name": "co-auto-research",
  "version": "0.1.2",
  "description": "A self-improving, autonomous AI research partner you stay in control of — with traceable evidence and steerable progress.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YihongT/CoAutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/YihongT/CoAutoResearch/issues"
  },
  "homepage": "https://yihongt.github.io/CoAutoResearch/",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "co-auto-research": "bin/auto-research.js",
    "auto-research": "bin/auto-research.js"
  },
  "files": [
    "bin/",
    "templates/",
    "docs/",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/verify-template.js && node scripts/ui-flow-test.js && node scripts/smoke-test.js",
    "verify": "node scripts/verify-template.js",
    "smoke": "node scripts/smoke-test.js",
    "visual:themes": "node scripts/visual-theme-check.js",
    "audit:ui": "node scripts/ui-audit-check.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "research",
    "self-improving",
    "autonomous",
    "human-centered",
    "codex",
    "scaffold",
    "template",
    "agent"
  ]
}

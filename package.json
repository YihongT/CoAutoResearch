{
  "name": "co-auto-research",
  "version": "2.0.0",
  "description": "An open-source research system for autonomous investigation, recursive self-improvement, and human–AI collaboration. Run experiments, refine methods through evidence and feedback, and turn traceable research into paper drafts.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YihongT/CoAutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/YihongT/CoAutoResearch/issues"
  },
  "homepage": "https://yihongt.github.io/CoAutoResearch/",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "co-auto-research": "bin/auto-research.js",
    "auto-research": "bin/auto-research.js"
  },
  "files": [
    "bin/",
    "templates/",
    "!templates/default/research_trajectory/.staging/**",
    "templates/default/research_trajectory/.staging/.gitkeep",
    "!templates/default/research_trajectory/.transactions/**",
    "templates/default/research_trajectory/.transactions/.gitkeep",
    "docs/",
    "!docs/_static/examples/**",
    "!docs/**/*.docx",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "assets/",
    "README.md",
    "README.zh-CN.md",
    "readme/",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/auto-research.js ui",
    "doctor": "node bin/auto-research.js doctor",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "ai-scientist",
    "ai-for-science",
    "autoresearch",
    "autonomous-research",
    "recursive-self-improvement",
    "self-improvement",
    "agentic-ai",
    "ai-agents",
    "llm-agents",
    "agent-skills",
    "research-agent",
    "research-automation",
    "human-ai-collaboration",
    "human-in-the-loop",
    "codex",
    "claude-code",
    "scientific-research",
    "scientific-writing",
    "paper-generation",
    "reproducible-research"
  ]
}

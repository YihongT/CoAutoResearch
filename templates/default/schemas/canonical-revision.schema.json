{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-revision.schema.json",
  "title": "Canonical Revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "project_id",
    "created_at",
    "updated_at",
    "extensions",
    "revision",
    "transaction_id",
    "published_trial_id",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "artifact_type": {
      "const": "canonical_revision"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/project_id"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "transaction_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/transaction_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_trial_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/trial_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trial.schema.json",
  "title": "Trial Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "project_id",
    "created_at",
    "updated_at",
    "extensions",
    "trial_id",
    "number",
    "title",
    "lifecycle_state",
    "trial_outcome",
    "target",
    "move",
    "base_revision",
    "publish_revision",
    "review_level",
    "active_line_ids",
    "campaign_ids",
    "stage_id",
    "closed_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "artifact_type": {
      "const": "trial"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/project_id"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    },
    "trial_id": {
      "$ref": "common.schema.json#/$defs/trial_id"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "enum": [
        "created",
        "planned",
        "preflight_passed",
        "executing",
        "distilled",
        "staged",
        "reviewing",
        "ready_to_publish",
        "published",
        "blocked",
        "needs_human",
        "invalidated",
        "aborted"
      ]
    },
    "trial_outcome": {
      "anyOf": [
        {
          "enum": [
            "advanced",
            "informative_negative",
            "no_state_change",
            "blocked",
            "needs_human",
            "invalidated",
            "aborted"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "enum": [
        "framing",
        "resource",
        "method",
        "data",
        "evaluation",
        "result",
        "claim",
        "manuscript",
        "process",
        "venue"
      ]
    },
    "move": {
      "enum": [
        "explore",
        "acquire",
        "build",
        "test",
        "diagnose",
        "compare",
        "synthesize",
        "repair",
        "decide",
        "package",
        "profile"
      ]
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "publish_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "review_level": {
      "enum": [
        "light",
        "standard",
        "full",
        "final"
      ]
    },
    "active_line_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/line_id"
      },
      "uniqueItems": true
    },
    "campaign_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/campaign_id"
      },
      "uniqueItems": true
    },
    "stage_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/stage_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "closed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
